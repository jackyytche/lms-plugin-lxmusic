<?xml version="1.0" encoding="UTF-8"?>
<extension>
	<id>8f4e2a91-6c3d-4b7e-a5d8-2f9c1e7b4a36</id>
	<!-- name/description 必须是 strings.txt 里的 token：LMS 的插件列表与设置下拉都用
	     `| string` 渲染它们，写显示串会渲染成空白（0.6.3 现场：设置下拉里 LX Music 是空行） -->
	<name>PLUGIN_LXMUSIC</name>
	<module>Plugins::LxMusic::Plugin</module>
	<version>0.11.51</version>
	<description>PLUGIN_LXMUSIC_DESC</description>
	<creator>jackyytche</creator>
	<email>noreply@example.com</email>
	<category>musicservices</category>
	<defaultState>enabled</defaultState>
	<!-- 设置入口：设置 → 插件 里那一行的 Settings 链接就是这里来的（漏了就没入口） -->
	<optionsURL>plugins/LxMusic/settings/basic.html</optionsURL>
	<!-- 插件图标（LMS 插件管理器那一行）：落雪桌面版官方图标（Apache-2.0，取自
	     lx-music-desktop/resources/icons/256x256.png），放插件自己的 HTML 目录下。
	     只放一张原图即可——LMS 网页层会把 `logo_50x50.png`/`logo_100x100.png`
	     这类带尺寸后缀的请求按需缩放后返回（设备实测：50/100/300 都能出图）。
	     repo.xml（pack.py 生成）里再给一条绝对 URL 的 <icon>，这样"未安装/待更新"
	     的列表项也有图标（相对路径在未安装时会被 LMS 改写成 slimserver 官方仓库地址，必 404）。 -->
	<icon>plugins/LxMusic/html/images/logo.png</icon>
	<type>2</type>
	<homepage URL="https://github.com/jackyytche/lms-plugin-lxmusic"/>
	<targetApplication>
		<id>Lyrion Music Server</id>
		<minVersion>7.7</minVersion>
		<maxVersion>*</maxVersion>
	</targetApplication>
</extension>
